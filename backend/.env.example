# ==============================================================================
# Sentinel SOS Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.
# NEVER commit .env with real credentials or secret keys to version control.
# ==============================================================================

# Application Configuration
SENTINEL_APP_NAME="Sentinel SOS Emergency Response API"
SENTINEL_ENV="development"
SENTINEL_API_PREFIX="/api/v1"
SENTINEL_DEBUG=True
SENTINEL_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL (Relational Data: Users, Responders, Assignments, Audit Logs)
SQL_DATABASE_URL="sqlite:///./sentinel_dev.db"
# Production example: postgresql://sentinel_user:change_me@localhost:5432/sentinel_sos
SQL_ECHO=False

# MongoDB (Document Store: Incident Events, Location History, Notification Logs)
MONGO_URI="mongodb+srv://divyas1031_db_user:<db_password>@cluster0.nnaz5i7.mongodb.net/?appName=Cluster0&compressors=zlib"
MONGO_DATABASE="sentinel_sos"

# Authentication & Security
AUTH_SECRET_KEY="insecure-dev-secret-key-please-replace-in-production-min-32-chars"
AUTH_ALGORITHM="HS256"
AUTH_TOKEN_EXPIRE_MINUTES=60

# Google Maps Platform (Reverse Geocoding, Places, Routes ETA)
MAPS_GOOGLE_API_KEY=""

# SMS Provider Integration (Options: mock, twilio, msg91)
SMS_PROVIDER="mock"
SMS_MSG91_API_KEY=""
SMS_TWILIO_ACCOUNT_SID=""
SMS_TWILIO_AUTH_TOKEN=""
SMS_TWILIO_API_KEY_SID=""
SMS_TWILIO_API_KEY_SECRET=""
SMS_TWILIO_FROM_NUMBER=""

# Push Notifications (Firebase Cloud Messaging)
PUSH_FCM_PROJECT_ID=""
PUSH_CREDENTIALS_PATH=""

# LLM Integration (Options: mock, openai, gemini)
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Email Provider (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sentinel SOS <onboarding@resend.dev>"

